{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skf-pro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self reference used by OpenNext; the service name must match the Worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "skf-pro",
    },
  ],
  // Run the Worker next to the Supabase database in Frankfurt.
  "placement": {
    "mode": "targeted",
    "region": "aws:eu-central-1",
  },
  "observability": {
    "enabled": true,
  },
  // Spam limit on placing orders (spec 0004 AC-10): 5 per 60 seconds per IP, per Cloudflare location.
  "ratelimits": [
    {
      "name": "ORDER_RATE_LIMITER",
      // Any number unique within the Cloudflare account.
      "namespace_id": "1004",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      // The live count behind the filters screen (spec 0010 AC-15): 60 calls a minute per IP.
      "name": "CATALOG_COUNT_RATE_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the id from `pnpm wrangler hyperdrive create skf-pro-db --connection-string=<session pooler URL>`.
      "id": "00000000000000000000000000000000",
      // Local `supabase start` database, used by `next dev` and `pnpm preview`.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
}
