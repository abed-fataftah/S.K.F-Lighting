{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skf-pro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The shop's only public address (spec 0028 AC-1); `www` redirects to it by a Cloudflare rule.
  "routes": [{ "pattern": "skf-lighting.com", "custom_domain": true }],
  "workers_dev": false,
  // workers_dev off also turns preview URLs off unless they are named on their own.
  "preview_urls": true,
  // `pnpm preview` and CI: without this, `wrangler dev` takes the route's host as the origin, so
  // the Worker sees every local request as the production domain (robots, sitemap, host checks).
  "dev": { "host": "localhost:8787" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self reference used by OpenNext; the service name must match the Worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "skf-pro",
    },
  ],
  // Run the Worker next to the Supabase database in Frankfurt.
  "placement": {
    "mode": "targeted",
    "region": "aws:eu-central-1",
  },
  "observability": {
    "enabled": true,
  },
  // The stats page's Web Analytics read (spec 0027; docs/runbooks/monitoring.md). Not secret. Fill in
  // both ids when the Web Analytics site exists; the token is a secret
  // (`pnpm wrangler secret put CF_ANALYTICS_API_TOKEN`). All empty shows the "not set up" notice.
  "vars": {
    "CF_ACCOUNT_ID": "",
    "CF_WEB_ANALYTICS_SITE_TAG": "",
  },
  // Spam limit on placing orders (spec 0004 AC-10): 5 per 60 seconds per IP, per Cloudflare location.
  "ratelimits": [
    {
      "name": "ORDER_RATE_LIMITER",
      // Any number unique within the Cloudflare account.
      "namespace_id": "1004",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      // The live count behind the filters screen (spec 0010 AC-15): 60 calls a minute per IP.
      "name": "CATALOG_COUNT_RATE_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      // Guest order lookups (spec 0015 AC-6): 5 tries a minute per IP...
      "name": "ORDER_LOOKUP_IP_LIMITER",
      "namespace_id": "1015",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      // ...and 5 a minute per order number, so guesses spread over many IPs stay slow.
      "name": "ORDER_LOOKUP_NUMBER_LIMITER",
      "namespace_id": "1016",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // `skf-pro-db`: the production session pooler, caching off (docs/runbooks/supabase-production.md).
      "id": "66d1fbf9c77e471d9e737778f6a81001",
      // Local `supabase start` database, used by `next dev` and `pnpm preview`.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
}
