# Copy to .env.local for `next dev`. Local values come from `pnpm db:start` (supabase status).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Digits with country code, 8 to 15, no plus or spaces (spec 0003). The test value below is not a real line.
NEXT_PUBLIC_WHATSAPP_NUMBER=970500000000

# "1" turns on the design system gallery at /design-system. Never set in production.
DESIGN_SYSTEM_PAGE=1

# Migrations, pg_dump, and scripts. In production: the Supabase session pooler URL (port 5432).
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres
